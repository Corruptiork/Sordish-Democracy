title: Malenyevist-wing Split
new-page: true 
subtitle: The Malenyevist's obstruction with our policies have grown too severe.
tags: event
view-if: malenyevist_dissent >= 60
on-arrival: malenyevist_split = 1; malenyevist_strength = malenyevist_strength/2; n_advisors -= 1 if levi_advisor == 1; levi_advisor = 0; ryf_strength -= 300; ryf_militancy -= 0.05 if ryf_militancy >= 0.1; n_advisors -= 1 if seydewitz_advisor == 1; seydewitz_advisor = 0; n_advisors -= 1 if rosenfeld_advisor == 1; rosenfeld_advisor = 0; n_advisors -= 1 if siemsen_advisor == 1; siemsen_advisor = 0
