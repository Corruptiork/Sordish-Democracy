on-arrival: {!
// set up the infrastructure
Q.cps_formed = 1;
Q.parties.push('cps');

Q.workers_cps = 10;
Q.workers_pfjp -= 3;
Q.new_middle_cps = 1;
Q.old_middle_cps = 0;
Q.rural_cps = 0;
Q.unemployed_cps = 2;
Q.bluds_cps = 0;

if (Q.unions_independent) {
    Q.workers_cps += 8;
}

// update all records
Q.cps_r = 0;
Q.old_cps_r = 0;
for (var record of Q.election_records) {
    record['cps'] = 0;
}
for (var record of Q.party_support_records) {
    record['cps'] = 0;
}
!}
